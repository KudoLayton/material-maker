          {
            "default": "0u",
            "label": "number",
            "name": "number",
            "type": "particle_uint"
          }
        ],
        "instance": "vec3 $(name)_evaluate(float speed, uint number) {\nfloat angle = float(number % 128u) * 2.399963;\nreturn vec3(cos(angle) * 1.5, speed, sin(angle) * 1.5);\n}",
