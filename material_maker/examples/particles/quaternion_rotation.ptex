    {
      "name": "Filter_Math_Quaternion_Multiply",
      "node_position": {
        "x": 840,
        "y": 480
      },
      "parameters": {},
      "seed_int": 0,
      "shader_model": {
        "global": "\nvec4 mm_quat_normalize(vec4 q) {\n\tfloat magnitude = max(max(abs(q.x), abs(q.y)), max(abs(q.z), abs(q.w)));\n\tif (!(magnitude > 0.000001) || isinf(magnitude)) { return vec4(0.0, 0.0, 0.0, 1.0); }\n\treturn normalize(q / magnitude);\n}\nvec4 mm_quat_multiply(vec4 a, vec4 b) {\n\ta = mm_quat_normalize(a);\n\tb = mm_quat_normalize(b);\n\treturn mm_quat_normalize(vec4(a.w*b.xyz + b.w*a.xyz + cross(a.xyz, b.xyz), a.w*b.w - dot(a.xyz, b.xyz)));\n}\nvec4 mm_quat_euler_yxz(vec3 angles) {\n\tvec3 s = sin(angles * 0.5);\n\tvec3 c = cos(angles * 0.5);\n\treturn mm_quat_multiply(mm_quat_multiply(vec4(0.0, s.y, 0.0, c.y), vec4(s.x, 0.0, 0.0, c.x)), vec4(0.0, 0.0, s.z, c.z));\n}\n",
        "inputs": [
          {
            "default": "vec4(0.0, 0.0, 0.0, 1.0)",
            "label": "A",
            "name": "a",
            "type": "rgba"
          },
          {
            "default": "vec4(0.0, 0.0, 0.0, 1.0)",
            "label": "B",
            "name": "b",
            "type": "rgba"
          }
        ],
        "longdesc": "Compose rotations A * B: apply B, then A. Current * Delta applies a local increment; Delta * Current applies a parent-space increment. Inputs and output are normalized; zero becomes identity. This is not component-wise multiplication.",
        "name": "Quaternion Multiply",
        "outputs": [
          {
            "rgba": "mm_quat_multiply($a($uv), $b($uv))",
            "shortdesc": "Quaternion (x, y, z, w)",
            "type": "rgba"
          }
        ],
        "parameters": []
      },
      "type": "shader"
    },
