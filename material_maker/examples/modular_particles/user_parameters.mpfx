          {
            "name": "ConeSample",
            "type": "particle_node",
            "seed_int": 0,
            "parameters": {},
            "settings": {
              "kind": "custom",
              "data_type": "vec3",
              "code": "vec3 axis_n=dot(axis,axis)>1e-12 ? normalize(axis) : vec3(0,1,0);\nvec3 helper=abs(axis_n.y)<0.999 ? vec3(0,1,0) : vec3(1,0,0);\nvec3 tangent=normalize(cross(helper,axis_n)); vec3 bitangent=cross(axis_n,tangent);\nfloat z=mix(1.0,cos(radians(clamp(angle,0.0,180.0))),random_value.x); float phi=6.283185307179586*random_value.y;\nfloat xy=sqrt(max(0.0,1.0-z*z)); float speed=mix(max(0.0,min(lo,hi)),max(0.0,max(lo,hi)),random_value.z);\nreturn speed*(axis_n*z+xy*(tangent*cos(phi)+bitangent*sin(phi)));",
              "editor_profile": "standard_module_v1",
              "input_ports": [
                {
                  "name": "axis",
                  "type": "vec3"
                },
                {
                  "name": "angle",
                  "type": "float"
                },
                {
                  "name": "lo",
                  "type": "float"
                },
                {
                  "name": "hi",
                  "type": "float"
                },
                {
                  "name": "random_value",
                  "type": "vec4"
                }
              ]
            },
