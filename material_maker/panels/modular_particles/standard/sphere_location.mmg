    {
      "name": "SphereSample",
      "type": "particle_node",
      "seed_int": 0,
      "parameters": {},
      "settings": {
        "kind": "custom",
        "data_type": "vec3",
        "code": "float z=2.0*random_value.x-1.0; float phi=6.283185307179586*random_value.y; float xy=sqrt(max(0.0,1.0-z*z));\nfloat r=max(radius,0.0)*(surface_only ? 1.0 : pow(random_value.z,1.0/3.0));\nreturn center+r*vec3(xy*cos(phi),z,xy*sin(phi));",
        "editor_profile": "standard_module_v1",
        "input_ports": [
          {
            "name": "center",
            "type": "vec3"
          },
          {
            "name": "radius",
            "type": "float"
          },
          {
            "name": "surface_only",
            "type": "bool"
          },
          {
            "name": "random_value",
            "type": "vec4"
          }
        ]
      },
      "node_position": {
        "x": 990,
        "y": 0
      }
    },
