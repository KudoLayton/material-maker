      "name": "VelocityStep",
      "type": "particle_node",
      "seed_int": 0,
      "parameters": {},
      "settings": {
        "kind": "custom",
        "data_type": "vec3",
        "code": "float dt=max(delta,0.0); return (velocity+acceleration*dt)*exp(-max(drag,0.0)*dt);",
